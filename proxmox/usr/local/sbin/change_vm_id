def main():
    parser = argparse.ArgumentParser(
        description="Rename a Proxmox VM ID (disks, config file, jobs.cfg)."
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Only describe the changes that would be made; don't perform them.",
    )
    parser.add_argument("old_vm_id", help="Current VM ID")
    parser.add_argument("new_vm_id", help="New VM ID")
    args = parser.parse_args()

    vmid = args.old_vm_id
    new_vmid = args.new_vm_id
    dry_run = args.dry_run

    if dry_run:
        print(f"=== DRY RUN: no changes will be made (VM {vmid} -> {new_vmid}) ===\n")

    # Check if VM is running
    vm_status = get_vm_status(vmid)
    if vm_status == "running":
        if dry_run:
            print(f"[DRY-RUN] VM ID {vmid} is currently running. Would require stopping the VM before changing IDs.")
        else:
            print(
                f"VM ID {vmid} is currently running. "
                "Please stop the VM before attempting to change VM IDs."
            )
            sys.exit(2)

    # Identify disks associated with the VM and rename them
    disk_renamer = VmDiskRenamer(vmid, dry_run=dry_run)
    # vm_disks = get_vm_disks(vmid)
    # for disk in vm_disks:
    #     new_disk_name = disk.replace(vmid, new_vmid)
    #     print(f"{'Would rename' if dry_run else 'Renaming'} VM disk {disk} -> {new_disk_name}")
    #     # rename_vm_disk(disk, new_disk_name, dry_run)
    #     disk_renamer.rename_disk(disk, new_disk_name)
    disk_renamer.rename_disks(new_vmid)

    # Update VM configuration file (replace vmid references)
    # update_vmid_references(old_conf, vmid, new_vmid, dry_run)
    vm_config_updater = VmConfigUpdater(vmid, dry_run=dry_run)
    vm_config_updater.update_vm_id(new_vmid)

    # if dry_run:
    #     print(f"[DRY-RUN] Would rename {old_conf} -> {new_conf}")
    # elif old_conf.exists():
    #     shutil.move(str(old_conf), str(new_conf))
    #     print(f"Renamed {old_conf} -> {new_conf}")

    # Update any jobs referencing the VM (lines containing "vmid", replace old id with new id)
    # replace_string_references(JOBS_CFG, vmid, new_vmid, dry_run, line_filter="vmid")

    if dry_run:
        print("\n=== DRY RUN complete: no changes were made ===")


if __name__ == "__main__":
    main()
