#!/usr/bin/env python3
"""
Rename a Proxmox VM's ID: renames its LVM disks, updates/renames its
qemu-server config file, and updates references in jobs.cfg.

Usage:
    rename_vm.py [--dry-run] <old_vm_id> <new_vm_id>

Example:
    rename_vm.py 100 200
    rename_vm.py --dry-run 100 200
"""

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

VMConfigDiskRe = re.compile(r"(?:^scsi\d+|disk\d+): ([^,]+)")


class LvmDiskMapping:
    """A mapping of LVM disk names to their volume group names."""

    def __init__(self):
        self._mapping = self._get_lvm_vg_mapping()

    @staticmethod
    def _get_lvm_vg_mapping():
        """Return the system disk/vg mapping."""
        output = capture_optional(["lvs", "-o", "lv_name,vg_name", "--noheadings"])
        if not output:
            return None

        mapping = {}
        for line in output.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                mapping[parts[0]] = parts[1]
        return mapping


    def get_vg_for_disk(self, disk):
        """Return the volume group name containing an LV named exactly like `disk`."""
        return self._mapping.get(disk)


class ZfsDataset:
    """A representation of a ZFS dataset."""

    def __init__(self, name):
        self._name = name

    @property
    def name(self):
        """Return the full dataset name."""
        return self._name

    @property
    def parent(self):
        """Return the parent dataset name, or None if this is a top-level dataset."""
        if "/" in self._name:
            return self._name.rsplit("/", 1)[0]
        return None

    @property
    def disk_name(self):
        """Return the last component of the dataset name (the disk name)."""
        return self._name.rsplit("/", 1)[-1]


class ZfsDiskMapping:
    """A mapping of ZFS dataset names to their full dataset paths."""

    def __init__(self):
        self._mapping = self._get_zfs_dataset_mapping()

    @staticmethod
    def _get_zfs_dataset_mapping():
        """Return the system disk/dataset mapping."""
        output = capture_optional(["zfs", "list", "-H", "-o", "name"])
        if not output:
            return None

        mapping = {}
        for line in output.splitlines():
            dataset = line.strip()
            disk_name = dataset.rsplit("/", 1)[-1]  # Get the last component
            mapping[disk_name] = dataset
        return mapping

    def get_dataset_for_disk(self, disk):
        """Return full ZFS dataset path if a dataset/volume ends with the disk name."""
        dataset = self._mapping.get(disk)
        if dataset:
            return ZfsDataset(dataset)
        return None


class VmDiskRenamer:
    """Handles renaming of VM disks, whether on LVM or ZFS."""

    def __init__(self, vm_id, dry_run=False):
        self._vm_id = vm_id
        self._dry_run = dry_run
        self._lvm_mapping = LvmDiskMapping()
        self._zfs_mapping = ZfsDiskMapping()

    def _get_vm_disks(self, vmid):
        output = capture(["qm", "config", vmid])
        disks = {}
        for line in output.splitlines():
            match = VMConfigDiskRe.search(line)
            if match:
                disk_ref = match.group(1).strip()
                if ":" not in disk_ref:
                    continue
                storage, disk_and_opts = disk_ref.split(":", 1)
                disk = disk_and_opts.split(",", 1)[0].strip()
                disks[disk] = {"storage": storage.strip()}
        return disks

    # def _find_lvm_vg_for_disk(self, disk):
    #     """Return the volume group name containing an LV named exactly like `disk`."""
    #     output = capture_optional(["lvs", "-o", "lv_name,vg_name", "--noheadings"])
    #     if not output:
    #         return None

    #     for line in output.splitlines():
    #         parts = line.split()
    #         if len(parts) >= 2 and parts[0] == disk:
    #             return parts[1]
    #     return None

    # def _find_zfs_dataset_for_disk(self, disk):
    #     """Return full ZFS dataset path if a dataset/volume ends with the disk name."""
    #     output = capture_optional(["zfs", "list", "-H", "-o", "name"])
    #     if not output:
    #         return None

    #     suffix = f"/{disk}"
    #     for line in output.splitlines():
    #         dataset = line.strip()
    #         if dataset == disk or dataset.endswith(suffix):
    #             return dataset
    #     return None

    def _rename_disk(self, disk, new_disk_name):
        """Rename a VM disk by auto-detecting whether it is on LVM or ZFS."""
        vg_name = self._lvm_mapping.get_vg_for_disk(disk)
        if vg_name:
            run(
                ["lvrename", vg_name, disk, new_disk_name],
                f"rename LV {disk} to {new_disk_name} in VG {vg_name}",
                self._dry_run,
            )
            return

        zfs_dataset = self._zfs_mapping.get_dataset_for_disk(disk)
        if zfs_dataset:
            parent = zfs_dataset.parent
            new_dataset = f"{parent}/{new_disk_name}" if parent else new_disk_name
            run(
                ["zfs", "rename", zfs_dataset.name, new_dataset],
                f"rename ZFS dataset {zfs_dataset.name} to {new_dataset}",
                self._dry_run,
            )
            return

        print(
            f"  Skipping disk {disk}: could not determine whether it is on LVM or ZFS",
            file=sys.stderr,
        )

    def rename_disks(self, new_vm_id):
        """Rename all disks associated with the VM to use the new VM ID."""
        vm_disks = self._get_vm_disks(self._vm_id)
        for disk in vm_disks:
            new_disk_name = disk.replace(str(self._vm_id), str(new_vm_id))
            print(f"{'Would rename' if self._dry_run else 'Renaming'} VM disk {disk} -> {new_disk_name}")
            self._rename_disk(disk, new_disk_name)


class VmConfigUpdater:
    """Handles updating VM configuration files."""

    QEMU_DIR = Path("/etc/pve/qemu-server")
    JOBS_CFG = Path("/etc/pve/jobs.cfg")

    def __init__(self, vm_id, dry_run=False):
        self._vm_id = vm_id
        self._config_path = self.QEMU_DIR / f"{vm_id}.conf"
        self._dry_run = dry_run

    def _update_vm_config(self, new_vmid):
        """
        Replace a string in a file and save the result. It's equivalent to
        `sed -i "s/old/new/g" path` but done in Python.

        If line_filter is given, only lines containing that substring are
        eligible for replacement (equivalent to `sed -i "/line_filter/ s/.../.../g"`).

        Returns True if the file was (or, in dry-run mode, would be) changed.
        """
        new_config_path = self.QEMU_DIR / f"{new_vmid}.conf"
        if not self._config_path.exists():
            print(f"Warning: {self._config_path} not found", file=sys.stderr)
            return False

        lines = self._config_path.read_text().splitlines(keepends=True)
        changed = False
        for i, line in enumerate(lines):
            match = VMConfigDiskRe.search(line)
            if match:
                lines[i] = line.replace(str(self._vm_id), str(new_vmid))
                if self._dry_run:
                    print(f"[DRY-RUN] Would replace '{self._vm_id}' with '{new_vmid}' in line: {line.strip()}", file=sys.stderr)
                changed = True

        if not changed:
            return False

        new_config = Path(new_config_path)
        if self._dry_run:
            print(f"[DRY-RUN] Would save changes replacing '{self._vm_id}' with '{new_vmid}' into {new_config}")
        else:
            new_config.write_text("".join(lines))
            print(f"Updated '{self._vm_id}' -> '{new_vmid}' in {new_config}")

        return True

    def _update_jobs_config(self, new_vmid, line_filter=None):
        """
        Replace a string in a file and save the result. It's equivalent to
        `sed -i "s/old/new/g" path` but done in Python.

        If line_filter is given, only lines containing that substring are
        eligible for replacement (equivalent to `sed -i "/line_filter/ s/.../.../g"`).

        Returns True if the file was (or, in dry-run mode, would be) changed.
        """
        path = Path(self.JOBS_CFG)
        if not path.exists():
            print(f"Warning: {path} not found", file=sys.stderr)
            return False

        lines = path.read_text().splitlines(keepends=True)
        changed = False
        for i, line in enumerate(lines):
            if line_filter is not None and line_filter not in line:
                continue
            if str(self._vm_id) in line:
                lines[i] = line.replace(str(self._vm_id), str(new_vmid))
                if self._dry_run:
                    print(f"[DRY-RUN] Would replace '{self._vm_id}' with '{new_vmid}' in line: {line.strip()}", file=sys.stderr)
                changed = True

        if not changed:
            return False

        if self._dry_run:
            scope = f"lines containing '{line_filter}' in" if line_filter else "in"
            print(f"[DRY-RUN] Would replace '{self._vm_id}' with '{new_vmid}' {scope} {path}")
        else:
            path.write_text("".join(lines))
            print(f"Updated '{self._vm_id}' -> '{new_vmid}' in {path}")

        return True


    def update_vm_id(self, new_vmid):
        self._update_vm_config(new_vmid)
        self._update_jobs_config(new_vmid, line_filter="vmid")


def run(cmd, description, dry_run):
    """Run (or, in dry-run mode, just describe) an external command."""
    if dry_run:
        print(f"[DRY-RUN] Would run: {' '.join(cmd)}  ({description})")
        return None
    print(f"Running: {' '.join(cmd)}  ({description})")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running {' '.join(cmd)}: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(result.returncode)
    return result.stdout


def capture(cmd):
    """Run a command and return stdout, regardless of dry-run (read-only)."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running {' '.join(cmd)}: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(result.returncode)
    return result.stdout


def capture_optional(cmd):
    """Run a probe command and return stdout, or None if it fails."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return None
    return result.stdout


def get_vm_status(vmid):
    """Equivalent of: qm status $vmid | awk '{print $2}'"""
    output = capture(["qm", "status", vmid])
    parts = output.split()
    return parts[1] if len(parts) >= 2 else ""


